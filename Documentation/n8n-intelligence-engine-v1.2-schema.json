{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline",
    "meeting_type",
    "meeting_type_label",
    "meeting_title",
    "meeting_subtitle",
    "meeting_objective",
    "meeting_importance",
    "importance_reason",
    "series_title",
    "executive_brief",
    "key_metrics",
    "key_takeaways",
    "decisions",
    "architecture",
    "risks",
    "dependencies",
    "tasks",
    "owners"
  ],
  "properties": {
    "headline": { "type": "string" },
    "meeting_type": {
      "type": "string",
      "enum": [
        "strategy",
        "product",
        "architecture",
        "planning",
        "status",
        "incident",
        "client",
        "board",
        "operations",
        "research",
        "partnership",
        "sales",
        "education",
        "personal",
        "interview",
        "retrospective",
        "workshop",
        "one_on_one",
        "review",
        "other"
      ]
    },
    "meeting_type_label": { "type": "string" },
    "meeting_title": { "type": "string" },
    "meeting_subtitle": { "type": "string" },
    "meeting_objective": { "type": "string" },
    "meeting_importance": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "importance_reason": { "type": "string" },
    "series_title": { "type": "string" },
    "executive_brief": { "type": "string" },
    "key_metrics": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "context",
          "relation",
          "current_value",
          "previous_value",
          "target_value",
          "target_period"
        ],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "context": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": ["current", "target", "current_to_target", "previous_to_current", "range", "change", "other"]
          },
          "current_value": { "type": "string" },
          "previous_value": { "type": "string" },
          "target_value": { "type": "string" },
          "target_period": { "type": "string" }
        }
      }
    },
    "key_takeaways": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "details", "business_priority"],
        "properties": {
          "title": { "type": "string" },
          "details": { "type": "string" },
          "business_priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "details", "business_priority"],
        "properties": {
          "title": { "type": "string" },
          "details": { "type": "string" },
          "business_priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sections"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["process", "components"]
        },
        "sections": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "mode", "layout", "items"],
            "properties": {
              "title": { "type": "string" },
              "mode": {
                "type": "string",
                "enum": ["process", "components"]
              },
              "layout": {
                "type": "string",
                "enum": ["process", "components"]
              },
              "items": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "description", "type", "business_priority"],
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "type": {
                      "type": "string",
                      "enum": ["process", "system", "integration", "data", "workflow", "other"]
                    },
                    "business_priority": {
                      "type": "string",
                      "enum": ["critical", "high", "medium", "low"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "business_priority", "impact", "mitigation"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "business_priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "impact": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "depends_on"],
        "properties": {
          "item": { "type": "string" },
          "depends_on": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "owner", "due_date", "status", "business_priority", "depends_on"],
        "properties": {
          "task": { "type": "string" },
          "owner": { "type": "string" },
          "due_date": { "type": "string" },
          "status": { "type": "string", "enum": ["open"] },
          "business_priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "responsibility"],
        "properties": {
          "name": { "type": "string" },
          "responsibility": { "type": "string" }
        }
      }
    }
  }
}
